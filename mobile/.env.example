# Volitelné. Bez souboru mobile/.env aplikace používá backend na Renderu
# (https://bankabezobrazovky.onrender.com) a funguje z jakékoli sítě.
#
# Lokální backend na tomto počítači (port 8000, telefon ve stejné síti):
# EXPO_PUBLIC_API_URL=lokalni
#
# Nebo libovolná jiná adresa:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
