# Vzor konfigurace backendu. Zkopírujte do backend/.env a doplňte vlastní hodnoty.
# Soubor .env se nikdy necommituje (viz .gitignore).

# Klíč OpenAI - jen na backendu, nikdy v mobilní aplikaci
OPENAI_API_KEY=

# Model pro agenta (tool calling)
OPENAI_MODEL=gpt-4o-mini

# Adresa, na které poslouchá FastAPI (telefony musí být ve stejné Wi-Fi)
API_HOST=0.0.0.0
API_PORT=8000
